{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zccuttingdie-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zccuttingdie-inquiries",
      "database_id": "6a0e2b94-0c37-4619-8d78-7964030bfc5b"
    }
  ],
  "routes": [
    { "pattern": "zccuttingdie.com", "custom_domain": true },
    { "pattern": "www.zccuttingdie.com", "custom_domain": true }
  ],
  "vars": {
    "INQUIRY_FROM": "Zhongcheng Cutting Die <inquiry@zccuttingdie.com>",
    "INQUIRY_TO": "zc.zhongcheng009@gmail.com",
    "INQUIRY_CC": "vampire_1993@163.com",
    "ALLOWED_ORIGIN": "https://zccuttingdie.com"
  }
}
